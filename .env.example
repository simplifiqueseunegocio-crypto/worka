# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Na Vercel, cadastre as mesmas variáveis.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente servidor (nunca use NEXT_PUBLIC_ nessas):
# chave secreta do Supabase (Project Settings > API Keys > Secret keys)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Conta Azul (cadastro de clientes): app criado no Portal do Desenvolvedor
# (developers.contaazul.com). A URL de redirecionamento cadastrada lá deve ser
# <APP_URL>/api/integracoes/conta-azul/retorno (veja Configurações → Conta Azul).
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
# opcional: força a URL de redirecionamento (padrão: APP_URL + /api/integracoes/conta-azul/retorno)
CONTA_AZUL_REDIRECT_URI=
# gere tokens com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# segredo que o Vercel Cron manda para /api/automacoes/* (Authorization: Bearer).
# Na Vercel, cadastre como CRON_SECRET e ela passa a enviar sozinha. Gere como o de cima.
CRON_SECRET=
# token que o worker de CND (integracoes/cnd) usa para chamar /api/integracoes/cnd/*
CND_WORKER_TOKEN=
# token que o robô do DET (integracoes/det) usa para chamar /api/integracoes/det/*
DET_ROBO_TOKEN=
# leitura de ficha ponto: IA para fotos e fichas escaneadas (PDF com texto é lido sem IA)
# PONTO_IA=groq ou claude (sem valor: usa a que tiver chave, Groq primeiro)
PONTO_IA=
# Groq (console.groq.com > API Keys); modelo de visão opcional em GROQ_MODELO
GROQ_API_KEY=
GROQ_MODELO=
# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# envio de e-mails pelo Resend (resend.com > API Keys); o remetente precisa ser
# de um domínio verificado no Resend (Domains), ex.: MCONT Contabilidade <nao-responda@mcont.com.br>
RESEND_API_KEY=
EMAIL_REMETENTE=
# opcional: para onde vão as respostas dos clientes
EMAIL_RESPONDER_PARA=
# endereço público da plataforma, usado nos links dos e-mails (ex.: definir senha).
# Sem ela, usa o endereço pelo qual o admin está acessando.
APP_URL=
